# BlueLab Voice Agent — local environment. Copy to `.env` and fill the secrets.
# REPO-4: there is deliberately NO Supabase URL / key here. The worker holds only what it needs to
# join LiveKit, call Claude (LLM) directly, and sign its api calls. STT + TTS go through LiveKit
# Inference (no provider keys) except the direct xAI TTS path (XAI_API_KEY).

ENVIRONMENT=development
LOG_LEVEL=INFO

# ── LLM: direct Anthropic (Claude isn't in the LiveKit Inference catalog) ──
ANTHROPIC_API_KEY=

# ── STT via LiveKit Inference (speechmatics/enhanced, swappable via STT_MODEL); TTS via the
# direct xAI plugin (needs XAI_API_KEY). ──
# STT_MODEL=speechmatics/enhanced
# TTS_MODEL=xai/tts-1
XAI_API_KEY=
# Direct Speechmatics plugin key. When set AND STT_MODEL is speechmatics/*, the worker uses the
# DIRECT plugin (the only path that sends the raw bilingual `ar_en` code — Inference normalizes it
# to ar-EN = Arabic-only). Leave empty to use the LiveKit Inference path.
SPEECHMATICS_API_KEY=

# ── LiveKit Cloud — worker registration + room join ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── BlueLab api — signed bundle fetch + HMAC callbacks ──
BLUELAB_API_URL=http://localhost:8000
# Scoped agent-callback HMAC secret. MUST equal the backend's AGENT_HMAC_SECRET (same value,
# per-service env name). The ONLY api credential the worker holds.
BLUELAB_AGENT_HMAC_SECRET=

# ── External-call budgets — sane defaults; override only if needed ──
# BUNDLE_FETCH_TIMEOUT_S=10
# CALLBACK_TIMEOUT_S=10

# ── LOCAL testing ONLY (never set in production) ──
# console mode carries no dispatch metadata, so this pins an attempt_id for the local mock backend.
# BLUELAB_LOCAL_ATTEMPT_ID=local-test-001
